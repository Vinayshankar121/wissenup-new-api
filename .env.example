# Copy this file to .env and fill in the values
# NEVER commit .env to git
# See .gitignore to ensure .env is ignored

# ========================================
# Spring Profile
# ========================================
SPRING_PROFILE=dev

# ========================================
# Database Configuration
# ========================================
