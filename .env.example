# ========================================
# WissenUp Backend - Environment Variables
# ========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# See .gitignore to ensure .env is ignored

# ========================================
# Spring Profile
# ========================================
SPRING_PROFILE=dev

# ========================================
# Database Configuration
# ========================================
DB_URL=jdbc:postgresql://localhost:5432/wissenup
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-database-password
DB_POOL_SIZE=10

# ========================================
# Server Configuration
# ========================================
SERVER_PORT=8080
MANAGEMENT_PORT=8081

# ========================================
# JWT Security
# ========================================
# Generate a random 256-bit key (32 bytes encoded in base64)
# Online tool: https://www.base64encode.org/ or use: openssl rand -base64 32
JWT_SECRET=your-256-bit-base64-encoded-secret-here-minimum-32-characters
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# ========================================
# OTP Configuration
# ========================================
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ========================================
# Email Configuration
# ========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-not-gmail-password

# ========================================
# CORS Configuration
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ========================================
# Security Configuration
# ========================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# Login Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ========================================
# Pagination
# ========================================
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=25

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO
WISSENUP_LOG_LEVEL=DEBUG
SECURITY_LOG_LEVEL=DEBUG

# ========================================
# Platform Configuration
# ========================================
SUPER_ADMIN_EMAIL=admin@wissenup.com

# ========================================
# Production Only (Ignore in Development)
# ========================================
# SSL_KEYSTORE_PATH=/path/to/keystore.p12
# SSL_KEYSTORE_PASSWORD=keystore-password
